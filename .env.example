# Required -- get your key from your WDGoWars profile at https://wdgwars.pl
WDGWARS_API_KEY=your_64_char_key_here

# Required -- host/port of the duplexer's SECOND connection slot, not the
# MeshCore node itself (the node only accepts one direct WiFi/TCP client;
# the duplexer is what lets this feeder listen alongside e.g. Home
# Assistant's meshcore-ha integration without stealing that slot).
MESHCORE_HOST=127.0.0.1
MESHCORE_PORT=5000

# WDGoWars upload endpoint
# WDGWARS_UPLOAD_URL=https://wdgwars.pl/api/upload/

# Seconds between uploads of buffered node sightings (default: 30)
# WDGWARS_FLUSH_INTERVAL=30

# Node records per upload request (default: 1000)
# WDGWARS_BATCH_SIZE=1000

# Seconds to wait before retrying the MeshCore connection after a drop
# (default: 10)
# WDGWARS_RECONNECT_DELAY=10

# Log verbosity: DEBUG, INFO, WARNING (default: INFO)
# WDGWARS_LOG_LEVEL=INFO
